{
  "manifest_version": 2,
  "name": "SoundFixer",
  "author": "levinion",
  "version": "1.5.0",
  "description": "SoundFixer fork with exponentially modulated gain",
  "browser_specific_settings": {
    "gecko": {
      "id": "soundfixer@unrelenting.technology"
    }
  },
  "icons": {
    "96": "icon.svg",
    "48": "icon.svg"
  },
  "permissions": ["activeTab", "webNavigation"],
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "SoundFixer",
    "default_popup": "popup.html",
    "theme_icons": [
      {
        "dark": "icon.svg",
        "light": "icon-inv.svg",
        "size": 64
      },
      {
        "dark": "icon.svg",
        "light": "icon-inv.svg",
        "size": 48
      },
      {
        "dark": "icon.svg",
        "light": "icon-inv.svg",
        "size": 32
      },
      {
        "dark": "icon.svg",
        "light": "icon-inv.svg",
        "size": 16
      }
    ],
    "browser_style": true
  }
}
